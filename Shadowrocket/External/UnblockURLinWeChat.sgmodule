#!name=微信110解锁被屏蔽的URL
#!desc=来源: QX (UnblockURLinWeChat)

[Script]
UnblockURLinWeChat_1 = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/asset/UnblockURLinWeChat.js

[MITM]
hostname = %APPEND% weixin110.qq.com, security.wechat.com
