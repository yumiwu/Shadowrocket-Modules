#!name=Google自动翻页
#!desc=来源: QX (EndlessGoogle)

[Script]
EndlessGoogle_1 = type=http-response, pattern=^https?:\/\/www\.google\..*\/search, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/endlessgoogle.js

[MITM]
hostname = %APPEND% www.google.*
