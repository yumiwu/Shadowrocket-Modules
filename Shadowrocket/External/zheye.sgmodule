zheye_1 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/people\/, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
