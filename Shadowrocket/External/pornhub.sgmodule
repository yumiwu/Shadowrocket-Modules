#!name=Pornhub去广告
#!desc=来源: https://raw.githubusercontent.com/ddgksf2013/Scripts/master/pornhub.js

[URL Rewrite]
^https:\/\/(cn|www)\.pornhub\.com\/_xa\/ads - reject-dict

[Script]
pornhub_1 = type=http-response, pattern=^https?:/\/(cn|www)\.pornhub\.com\/($|(view|video).*$), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/pornhub.js

[MITM]
hostname = %APPEND% *.pornhub.com
