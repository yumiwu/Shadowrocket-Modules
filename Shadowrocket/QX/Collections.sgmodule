#!name=仓库地址: https://github.com/Moli-X
#!desc=来源: QX (Collections)

[URL Rewrite]
^https:\/\/(cn|www)\.pornhub\.com\/_xa\/ads - reject-dict

[Script]
Collections_1 = type=http-response, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js
Collections_2 = type=http-request, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
Collections_3 = type=http-response, pattern=^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/v\d\/(h\d\/vip|vip|user)\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MeiTu.js
Collections_4 = type=http-response, pattern=^https:\/\/api\.xiuxiu\.meitu\.com\/v1, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MTxiuxiu.js
Collections_5 = type=http-response, pattern=^https?:/\/(cn|www)\.pornhub\.com\/($|(view|video).*$), requires-body=1, max-size=0, script-path=https://github.com/ddgksf2013/Scripts/raw/master/pornhub.js
Collections_6 = type=http-response, pattern=^https://m.douban.com/movie/subject/.+, requires-body=1, max-size=0, script-path=https://github.com/ddgksf2013/Scripts/raw/master/douban.js
Collections_7 = type=http-request, pattern=^https://m.douban.com/movie/subject/.+\?seen=\d, requires-body=0, max-size=0, script-path=https://github.com/ddgksf2013/Scripts/raw/master/douban.js
Collections_8 = type=http-response, pattern=^https?:\/\/m\.douban\.com\/movie\/subject\/\d+\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/I-am-R-E/QuantumultX/main/JavaScript/DouBan.js
Collections_9 = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/asset/UnblockURLinWeChat.js
Collections_10 = type=http-response, pattern=^https:\/\/www.youtube.com\/api\/timedtext.+, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Neurogram-R/Quantumult-X/main/Dualsub.js
Collections_11 = type=http-response, pattern=^https?:\/\/restore-access\.indream\.app\/restoreAccess, requires-body=1, max-size=0, script-path=https://github.com/Moli-X/Resources/raw/main/Script/Nicegram.js

[MITM]
hostname = %APPEND% boxjs.com, boxes.net, sub.store, spclient.wg.spotify.com, appwk.baidu.com, pan.baidu.com, restore-access.indream.app, *wps*, *.xiuxiu.meitu.com, api.xiuxiu.meitu.com, ap*.intsig.net, testflight.apple.com, *.pornhub.com, cupfox.app, *.youtube.com, app.bilibili.com, app.biliapi.net, app.biliintl.com, api.weibo.cn, mapi.weibo.com, *.uve.weibo.com, youtubei.googleapis.com, cn-acs.m.cainiao.com, guide-acs.m.taobao.com, weixin110.qq.com, security.wechat.com, m.douban.com
