#!name=知乎处理用户信息
#!desc=来源: QX (Zhihu)

[URL Rewrite]
^http[s]?:\/\/api\.zhihu\.com\/commercial_api\/launch_v2 - reject-dict
^http[s]?:\/\/api\.zhihu\.com\/commercial_api\/real_time_launch_v2 - reject-dict
URL-REGEX,^https?:\/\/api\.zhihu\.com\/commercial_api\/launch_v2\? - reject-dict
^https?:\/\/api\.zhihu\.com\/moments\/recent - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4\/answers\/\d+\/recommendations - reject-dict
^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count|v\d\/package|me\/guides|drama\/living-info|ad|fringe|commercial|market\/popovers|.*featured-comment-ad|ad-style-service) - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4/(questions|anwsers)\/\d+/related-readings - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4\/hot_recommendation - reject-dict
^https?:\/\/www\.zhihu\.com\/commercial_api\/banners_v3\/mobile_banner - reject-dict
^https?:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation - reject-dict
^https?:\/\/api\.zhihu\.com\/brand\/question\/\d+/card\? - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v\d+\/brand\/question/\d+/card\? - reject-dict
^https?:\/\/api\.zhihu\.com/moments/hybrid\? - reject-dict
^https?:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config - reject-200
^https?:\/\/api\.zhihu\.com\/people\/self\/new_user_card - reject-200
^https?:\/\/api\.zhihu\.com\/moments\/tab_v2 - reject-dict
^https?:\/\/api\.zhihu\.com\/explore\/entry\/tips - reject

[Script]
Zhihu_1 = type=http-response, pattern=^http[s]?:\/\/api\.zhihu\.com\/(people\/self|unlimited\/go\/my_card|sku\/reversion_sku_ext).*$, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/WeiRen0/Scripts/main/ZHVIP.js
Zhihu_2 = type=http-request, pattern=http[s]?:\/\/.*zhihu\.(com|cn)\/(appview\/v2\/answer|remix-web\/paid_columns.*manuscript|market\/paid_column|appview\/p|api\/v3\/books|books|market\/paid_magazine).*$, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/WeiRen0/Scripts/main/ZHTK.js
Zhihu_3 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/people\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_4 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(moments|topstory)(\/|\?)?(recommend|action=|feed_type=)(?!\/people), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_5 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(v4\/)?questions\/\d+, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_6 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/settings\/blocked_users, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_7 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/notifications\/v3\/(message|timeline\/entry\/system_message), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_8 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/preset_words\?, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_9 = type=http-response, pattern=^https?:\/\/appcloud2\.zhihu\.com\/v\d+\/config, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_10 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/top_search\/tabs\/hot\/items, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_11 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/topstory\/hot-lists?(\?|\/), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_12 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(comment_v5\/)?(answers|comments?|articles|pins)\/\d+\/(root_|child_)?comments?, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_13 = type=http-response, pattern=^https?:\/\/www\.zhihu\.com\/appview\/v2\/answer\/.*(entry=(?!(preload-topstory|preload-search|preload-subscription)))?, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js
Zhihu_14 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/feed-root\/sections\/query\/v2, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/zhihu/zhihu.js

[MITM]
hostname = %APPEND% 61.243.13.*, 58.144.248.*, 120.92.107.*, www.zhihu.com, api.zhihu.com, datahub.zhihu.com, sugar.zhihu.com, appcloud.zhihu.com, duga.zhihu.com, web-er.zhihu.com, lens.zhihu.com, 103.41.167.237, 58.144.248.94, 14.204.51.105, 103.41.167.236, 103.41.167.234, 103.41.167.226, 103.41.167.235, 113.62.116.232, 103.41.167.*, 103*, zhuanlan.zhihu.com, 183.204.14.111, 125.77.176*, 27.148*, 183.204*, 122.224*, 60.188.72*, 120.220*, 120.222*, 150.109.91*, *.zhihu.*
