[URL Rewrite]
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d\/tag\/ads_engage - reject-dict
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/apple\/record - reject-dict
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/resource - reject-dict
^https?:\/\/referee\.xiaohongshu\.com\/v\d\/stateReport - reject-dict
^https?:\/\/pages\.xiaohongshu\.com\/data\/native\/matrix_switches - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/user\/teenager\/status - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(open|get_style)\? - reject-array

[Script]
XHS_1 = type=http-response, pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config, requires-body=1, max-size=0, script-path=https://github.com/Moli-X/Resources/raw/main/Script/Xiaohongshu.js
XHS_2 = type=http-response, pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/homefeed\?, requires-body=1, max-size=0, script-path=https://github.com/Moli-X/Resources/raw/main/Script/Xiaohongshu.js
XHS_3 = type=http-response, pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/config\?, requires-body=1, max-size=0, script-path=https://github.com/Moli-X/Resources/raw/main/Script/Xiaohongshu.js

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com, pages.xiaohongshu.com, referee.xiaohongshu.com
