#!name=MgTV
#!desc=Converted from QX: MgTV

[URL Rewrite]
^https?://mobile.da.mgtv.com\/m\/page - reject

[Script]
MgTV_1 = type=http-response, pattern=^https?:\/\/.*mgtv.com.*(GetUserInfo|module\/list\?_support|app\/bdboot|pullReleaseInfo|floor\/detail|video\/source|entry\?_support).*$, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtv.js
MgTV_2 = type=http-request, pattern=^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source\?, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtk.js

[MITM]
hostname = %APPEND% *mgtv.com
