#!name=酷我音乐SVIP+净化
#!desc=来源: https://raw.githubusercontent.com/Moli-X/Resources/main/Script/Kuwo/Kuwo.js

[Script]
Kuwo_1 = type=http-response, pattern=^https?:\/\/.*(kuwo|lrts).*(music\.pay\?ne|\/a\.p|v\d\/api\/(user\/in|pay\/vi)|\w{3}\/v\d\/user\/vi|\w{3}\/spi\/ms|\w{3}\/v\d\/the|\w{3}\/enc\/use), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/Kuwo/Kuwo.js
Kuwo_2 = type=http-request, pattern=^https?:\/\/.*(kuwo|lrts).*(music\.pay\?ui), requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/Kuwo/Kuwo.js

[MITM]
hostname = %APPEND% *kuwo*, *lrts*
