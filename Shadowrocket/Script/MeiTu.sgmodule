#!name=✅美图秀秀vip
#!desc=来源: Script (Script/MTxiuxiu/MeiTu.js)

[Script]
MeiTu_1 = type=http-response, pattern=^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/v\d\/(h\d\/vip|vip|user)\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MeiTu.js
MeiTu_2 = type=http-response, pattern=^https:\/\/api\.xiuxiu\.meitu\.com\/v1, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MeiTu.js

[MITM]
hostname = %APPEND% *.xiuxiu.meitu.com, api.xiuxiu.meitu.com
