[URL Rewrite]
^https:\/\/(cn|www)\.pornhub\.com\/_xa\/ads - reject-dict

[Script]
Pornhub_1 = type=http-response, pattern=^https?:/\/(cn|www)\.pornhub\.com(\/?$|\/([?]|view|video).*$), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/Pornhub/Pornhub.js

[MITM]
hostname = %APPEND% *.pornhub.com
