#!name=订阅合集
#!desc=适用于Loon的订阅合集

[Script]
BoxJs = type=http-request, pattern=^https?:\/\/(.+\.)?boxjs\.(com|net), script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js, requires-body=1, timeout=120, img-url=https://github.com/Moli-X/Resources/raw/main/Icon/Image/BoxJs.png
Loon-Gallery = type=http-request, pattern=^https?:\/\/xn--ck8h\.com, script-path=https://raw.githubusercontent.com/Peng-YM/Loon-Gallery/master/backend/gallery.js, requires-body=1, timeout=120, img-url=https://github.com/Moli-X/Resources/raw/main/Icon/Image/Gallery.png
Nicegram会员 = type=http-request, pattern=^https?:\/\/restore-access\.indream\.app\/restoreAccess\?id=\w+$, script-path=https://raw.githubusercontent.com/I-am-R-E/Functional-Store-Hub/Master/Nicegram/Script/Nicegram.js, timeout=10, img-url=https://github.com/Moli-X/Resources/raw/main/Icon/Image/Nicegram.png
解除微信链接 = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, script-path=https://raw.githubusercontent.com/zZPiglet/Task/master/asset/UnblockURLinWeChat.js, requires-body=1, timeout=60 , img-url=https://github.com/Moli-X/Resources/raw/main/Icon/Image/WeChat.png
Collection_5 = type=http-request, pattern=^https?:/\/(cn|www)\.pornhub\.com\/($|(view|video).*$), script-path=https://github.com/ddgksf2013/Scripts/raw/master/pornhub.js
douban_15 = type=http-response, pattern=^https?:\/\/m\.douban\.com\/(home_guide|movie|tv|book|group|music), script-path=https://github.com/ddgksf2013/Scripts/raw/master/douban.js, requires-body=1, timeout=60

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net, xn--ck8h.com, restore-access.indream.app, mp.weixin.qq.com, weixin110.qq.com, security.wechat.com, api.aliyundrive.com, api.m.jd.com, *.pornhub.com, cn-acs.m.cainiao.com, guide-acs.m.taobao.com, m.douban.com
