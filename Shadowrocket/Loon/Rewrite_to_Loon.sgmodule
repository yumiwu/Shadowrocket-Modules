#!name=Rewrite_to_Loon
#!desc=Converted from Loon: Rewrite_to_Loon

[Script]
QX转化Loon = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+(qx$|qx\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/QX_Rewrite_Parser.js, requires-body=1, timeout=10
Surge转化Loon = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+[^Ttm](sg$|sg\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/Surge_Rewrite_Parser.js, requires-body=1, timeout=10
Loon插件控制器 = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+(loon$|loon\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/Loon_Rewrite_Parser.js, requires-body=1, timeout=10
规则集转换 = type=http-request, pattern=r_parser.list$|r_parser.list\?.*, script-path=https://raw.githubusercontent.com/chengkongyiban/stash/main/js/rule_parser.js, requires-body=1, timeout=10
脚本转换 = type=http-request, pattern=_script-converter-(stash|surge|loon|shadowrocket)\.js$, script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/script-converter/script-converter.js, requires-body=1, timeout=10
脚本转换2 = type=http-request, pattern=_script-converter-(STASH|SURGE|LOON|SHADOWROCKET)\.js$, script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/script-converter/script-converter.js, requires-body=1, timeout=10, argument="wrap_response=true"

[MITM]
hostname = %APPEND% github.com, raw.githubusercontent.com, gist.githubusercontent.com, gitlab.com, yfamily.ml
