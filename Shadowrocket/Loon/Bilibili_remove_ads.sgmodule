#!name=Bilibili去广告
#!desc=过滤Bilibili广告

[Rule]
URL-REGEX, ^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH, REJECT-DICT
URL-REGEX, ^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH, REJECT-DICT

[URL Rewrite]
^https:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource\? - reject-dict
^https:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? - reject-dict
^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ - reject
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/season\/app\/related\/recommend\? - reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
^https:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords - reject
^https:\/\/app\.bilibili\.com\/x\/resource\/ip - reject
^https:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp - reject-200
(^https:\/\/(www|m)\.bilibili\.com\/video\/((BV\w{10})|(av\d{9})))(\/\?.*) $1 302
(^https:\/\/live\.bilibili\.com\/\d+)((\?.*)) $1 302

[Script]
移除播放页面视频列表广告 = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除搜索结果广告 = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除评论区广告 = type=http-response, pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除动态页面广告 = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除交互式弹幕 = type=http-response, pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除交互式弹幕 = type=http-response, pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/DmView, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除青少年弹窗 = type=http-response, pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_helper_beta.js, requires-body = true, binary-body-mode = true
移除开屏广告 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show)\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除首页推荐广告 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除右上角活动入口 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除直播内容和大会员专享 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
精简首页顶部标签 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除热搜广告 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除观影页广告 = type=http-response, pattern=^https:\/\/api\.bilibili\.com\/pgc\/page\/(bangumi|cinema\/tab\?), script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除直播间广告 = type=http-response, pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
移除皮肤推送 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true
精简我的页面 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/account\/(mine\?|mine\/ipad\?), script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Bilibili/Bilibili_remove_ads.js, requires-body = true

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, grpc.biliapi.net, www.bilibili.com, m.bilibili.com, live.bilibili.com
