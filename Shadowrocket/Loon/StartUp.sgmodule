Pornhub_223 = type=http-response, pattern=^https?:/\/(cn|www)\.pornhub\.com(\/?$|\/([?]|view|video).*$), script-path=https://github.com/Moli-X/Resources/raw/main/Script/Pornhub/Pornhub.js, requires-body=1, timeout=60
