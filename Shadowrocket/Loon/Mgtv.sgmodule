#!name=Mgtv
#!desc=Converted from Loon: Mgtv

[Script]
芒果TV = type=http-response, pattern=^https?:\/\/.*mgtv.com.*(GetUserInfo|module\/list\?_support|app\/bdboot|pullReleaseInfo|floor\/detail|video\/source|entry\?_support).*$, script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtv.js, requires-body=1, timeout=60
芒果TV = type=http-request, pattern=^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source\?, script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtk.js, timeout=60

[MITM]
hostname = %APPEND% *mgtv.com
