#!name=Spotify会员
#!desc=来源: Loon (Spotify)

[Script]
spotifyJson = type=http-request, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js, timeout=10
spotifyProto = type=http-response, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js, requires-body=1, binary-body-mode=true, timeout=10
Spotify歌词翻译 = type=http-response, pattern=^https:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/, script-path = https://github.com/Moli-X/Resources/raw/main/Loon/Spotify/Spotify_Lyrics.js, requires-body = true, binary-body-mode = true

[MITM]
hostname = %APPEND% spclient.wg.spotify.com
