#!name=Convert
#!desc=Converted from Loon: Convert

[Script]
QX转化Loon = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+(qx$|qx\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/QX_Rewrite_Parser.js, requires-body=1, timeout=10
Surge转化Loon = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+(sg$|sg\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/Surge_Rewrite_Parser.js, requires-body=1, timeout=10
Loon插件控制器 = type=http-request, pattern=^https?:\/\/.+\/[^/]+\.[^/]+(loon$|loon\?.+=), script-path=https://github.com/chengkongyiban/stash/raw/main/js/Loon_Rewrite_Parser.js, requires-body=1, timeout=10
规则集转换 = type=http-request, pattern=r_parser.list$|r_parser.list\?.*, script-path=https://raw.githubusercontent.com/chengkongyiban/stash/main/js/rule_parser.js, requires-body=1, timeout=10
脚本转换 = type=http-request, pattern=_script-converter-(stash|surge|loon|shadowrocket)\.js$, script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/script-converter/script-converter.js, requires-body=1, timeout=10
脚本转换2 = type=http-request, pattern=_script-converter-(STASH|SURGE|LOON|SHADOWROCKET)\.js$, script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/script-converter/script-converter.js, requires-body=1, timeout=10, argument="wrap_response=true"
Script Hub: 前端 = type=http-request, pattern=^https?:\/\/script\.hub\/$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js
Script Hub: QX 转换 Loon = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=qx-rewrite, script-path=https://github.com/Script-Hub-Org/Script-Hub/raw/main/QX-Rewrite-Parser.js
Script Hub: Loon 插件控制器 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=loon-plugin, script-path=https://github.com/Script-Hub-Org/Script-Hub/raw/main/Loon-Rewrite-Parser.js
Script Hub: Surge 转换 Loon = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=surge-module, script-path=https://github.com/Script-Hub-Org/Script-Hub/raw/main/Surge-Rewrite-Parser.js
Script Hub: 规则集转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://github.com/Script-Hub-Org/Script-Hub/raw/main/rule-parser.js
Script Hub: 脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js

[MITM]
hostname = %APPEND% github.com, raw.githubusercontent.com, gist.githubusercontent.com, gitlab.com, yfamily.ml, script.hub, *.script.hub
